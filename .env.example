# Copy to .env for local notes. The Lambda functions read the process
# environment (or the function configuration), not this file.
# Leave secrets out of git. AWS credentials come from the default
# credential chain: an IAM role on Lambda, or ~/.aws/credentials locally.

DYNAMODB_TABLE=urls
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=urls
AWS_REGION=us-west-1
PORT=8000
